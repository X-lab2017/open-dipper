function layerInfo(id:LayerId){const l=layerById[id];modal(tr(l.name),`<div class="layer-dialog-title">${symbol(id)}<strong>${pointIndex[id].length}</strong><span>${isRegional(id)?t('地域统计条目','regional records'):t('可定位实体','located entities')}</span>${l.demo?'<span class="demo-tag">DEMO</span>':''}</div><p>${esc(sourceText(id,state.lang,data))}</p><p>${isArea(id)?t('地域色块使用独立对数色阶。开发者组至多选一项，可全部取消。地图一次展示一个主色阶；资产气泡和实体点可叠加。','Each area metric uses its own logarithmic scale. Developer selections are optional and exclusive. Use one fill at a time; asset bubbles and entity points overlay it.'):isBubble(id)?t('气泡面积与地域资产数量成正比；圆心是地域汇总参考点，不是仓库或设施地址。资产组至多选一项，也可全不选。缺少地域数据时不绘制气泡。','Bubble area is proportional to regional asset count. Centers are regional references, not repository or facility addresses. Asset selection is optional and exclusive; missing regional data produces no bubbles.'):t('圆点表示单个实体，颜色区分类别。环状纹理用于辨识图层，不表示数值；缺少地点证据时不放置点位。','Circles represent entities; color and ring patterns identify categories, not magnitude. Records without location evidence are not placed.')}</p>${id==='news'?`<p>${actualEvents().length} ${t('条已采集内容；','collected items; ')}${pointIndex.news.length} ${t('条已有定位','located items')}</p>`:''}<button class="primary" id="info-toggle">${state.active.includes(id)?t('取消选择','Deselect layer'):t('加入观察','Select layer')}</button>`);document.querySelector('#info-toggle')!.addEventListener('click',()=>changeActive(toggleLayer(state.active,id)));}
function entityInfo(p:Point){if(p.event){openEvent(p.event);return;}modal(tr(p.entityName??[p.country,p.country]),`<p>${esc(tr(p.locationRole??layerById[p.overlayId].metric))} · ${esc(countryName(p,state.lang))}</p><div class="entity-coordinates">${p.longitude!=null&&p.latitude!=null?`${p.longitude.toFixed(2)}°, ${p.latitude.toFixed(2)}°`:t('位置待核验','Location unverified')}</div><p>${p.precision?esc(tr(p.precision)):''}</p><p>${p.period?esc(tr(p.period)):''}</p><div class="entity-metrics">${p.metrics?.map(([k,v])=>`<div><span>${esc(metricName(k))}</span><b>${typeof v==='number'?fmt(v):esc(v)}</b></div>`).join('')??''}</div><p>${p.note?esc(tr(p.note)):esc(sourceText(p.overlayId,state.lang,data))}</p><div class="entity-sources">${p.sourceUrls?.filter(Boolean).map((u,i)=>`<a href="${esc(safeUrl(u))}" target="_blank" rel="noopener">${t('证据','Evidence')} ${i+1} · ${esc(new URL(safeUrl(u)).hostname)} ↗</a>`).join('')??''}</div><button class="primary" id="locate-entity" ${p.longitude==null||p.latitude==null?'disabled':''}>${t('定位此实体','Locate entity')}</button>`);document.querySelector('#locate-entity')!.addEventListener('click',()=>{state.entity=p;state.inspect=p.overlayId;if(p.id&&!state.entityTabs.some(x=>x.id===p.id&&x.overlayId===p.overlayId))state.entityTabs.push(p);if(!state.active.includes(p.overlayId))state.active=toggleLayer(state.active,p.overlayId);state.hidden=state.hidden.filter(id=>id!==p.overlayId);state.selected=regionGroup(p.rawCode);state.mobile='map';render();window.scrollTo({top:0,behavior:'instant'});scene?.locate(p.longitude!,p.latitude!,2.5);});}

function help(){modal(t('全球观测 · 使用指南','Observatory · how to use'),`<p>${t('拖拽移动，滚轮缩放；点击地域或实体圆点，在右侧查看指标与来源。展开地图后按 Esc 返回。','Drag to move, scroll to zoom; select a region or circular marker to inspect its metrics and sources. Press Escape to return from the expanded map.')}</p><div class="help-steps"><div><b>01</b><h3>${t('选择观察对象','Select subjects')}</h3><p>${t('六类、十八层。地域色块用于规模、贡献与影响；资产气泡用面积表示数量；实体圆点用于有地点证据的组织、项目、设施与动态。','Six groups and eighteen layers. Areas show regional magnitude; bubble area encodes asset quantity; entity points locate organizations, projects, facilities and events.')}</p></div><div><b>02</b><h3>${t('一种色块、一种气泡、多种实体','One fill, one bubble layer, multiple entities')}</h3><p>${t('开发者组、资产组各自至多选一项，再次点击即可取消。不同面指标用主色阶切换；资产气泡和实体点可以共同叠加，支持透明度、隐藏和独显。','Developer and asset groups allow zero or one selection; click again to deselect. Switch between area fills, and overlay bubbles and entity points with opacity, visibility and isolation controls.')}</p></div><div><b>03</b><h3>${t('分别计量，按对象展开','Inspect separate measures')}</h3><p>${t('全球概览固定。每个已选图层、每个打开的实体都有独立标签。项目与资产采用排行榜；全球排名不会因地域选择改变。可用左右方向键切换标签、Delete 关闭标签，不同口径分别计量。','Global coverage stays fixed. Each selected layer and opened entity has its own tab. Project and asset rankings retain their global scope. Use arrow keys to switch tabs and Delete to close. Different measures remain separate.')}</p></div></div><p>${t('项目点位按关联组织或发布方归属，不代表历史发起地、训练或部署地点。未定位原表条目保留在第二屏清单。','Project points use associated organizations or publishers, not historical origin, training or deployment. Unlocated report records remain in the second-screen catalog.')}</p>`);}
function pulseHelp(){modal(t('生态脉动 · 基数与模拟增量','Ecosystem pulse · baselines & simulated increments'),`<p>${t('每 2.2 秒刷新一次演示增量。数字增长、事件、位置关联、平台活跃条和趋势均为模拟，尚未接入实时采集。大数字是下列基数加演示增量，并不回写真实地图、排行榜或全球概览。','Illustrative increments refresh every 2.2 seconds. Growth, events, geographic attribution, platform bars and trends are simulated; live ingestion is not connected. Counters add demo growth to the baselines below without modifying actual map metrics, rankings or the overview.')}</p><div class="source-block"><h3>${t('活跃开发者','Active developers')}</h3><p>${fmt(dashboard.upstream.summary.activeDevelopers)} · GitHub · 2025.07—2026.06。${t('报告基数 2,890.36 万；后续增长为模拟。','Report baseline of 28.90M; subsequent growth is synthetic.')}</p></div><div class="source-block"><h3>${t('Git 事件 · 提交量推演','Git events · commit scenario')}</h3><p>${t('2025 年 Git 提交量突破 10 亿、2026 年预计 140 亿，为项目方提供的规划口径，尚未独立核验。主数将 140 亿年度预测按自然年均匀分配至本次更新日，再叠加演示增量；既不是实测累计，也不代表所有 Git 事件类型。不据此计算精确同比增幅。','The project-provided assumptions (>1B commits in 2025, projected 14B in 2026) are not independently verified. The counter linearly allocates the annual forecast to this review date, then adds demo increments. It is neither an observed cumulative total nor all Git event types; no exact year-on-year growth is inferred.')}</p></div><div class="source-block"><h3>${t('活跃仓库 · 代码 / 模型 / 数据','Active repositories · code / models / data')}</h3><p>${fmt(dashboard.activeRepositories.value)} · ${tr(dashboard.activeRepositories.scope)} ${t('模型 72,280、数据集 12,291 为累计发布样本，不并入活跃基数。演示增量模拟三类仓库的后续活动，不是实际新增仓库。','The 72,280 model and 12,291 dataset publication samples are not active counts and are excluded. Demo increments illustrate future activity across all three repository types, not actual new repositories.')}</p></div><div class="source-block"><h3>${t('实时资讯','Live intelligence')}</h3><p>${t('从 12,840 条模拟规模起步，演示资讯汇入。右侧新闻与活动则使用现有采集快照，保留原始日期，两者不混合。','Starts from an illustrative inventory of 12,840 to demonstrate ingestion. The right-hand news/event tabs use existing sourced snapshots with original dates; they remain separate.')}</p></div><p>${t('七个信息源的数字为最近 60 秒的模拟参与者；arXiv 展示研究动态。可暂停、逐条推进、切换倍速或关闭地图联动；减少动态时暂停自动播放，后台或不可见时停止推进。','The seven sources show simulated participants over 60 seconds; arXiv illustrates research activity. Pause, step, change speed or disable map pulses; reduced motion pauses playback and hidden/offscreen views stop advancing.')}</p>`);}
function pulseEvent(e:PulseEvent){modal(t('模拟事件','Simulated event'),`<span class="simulation-badge">${t('模拟演示 · 非实时数据','SIMULATION · NOT LIVE DATA')}</span><h3 class="pulse-detail-title">${esc(e.place[state.lang==='zh'?0:1])} · ${esc(e.platform)}</h3><div class="pulse-detail-value">+${e.quantity} <span>${pulseLabels[e.kind][state.lang==='zh'?0:1]}</span></div><p>${t('仅为演示全球事件与地图的联动效果，事件及地点关联均为模拟。已暂停播放，关闭后可继续。','This illustrates the interaction between global events and the map. Both events and place attribution are synthetic. Playback is paused; resume when ready.')}</p><button class="primary" id="locate-pulse">${t('定位演示地点','Locate demo place')}</button>`);document.querySelector('#locate-pulse')!.addEventListener('click',()=>{document.querySelector('#modal-root')!.replaceChildren();state.mobile='map';if(window.innerWidth<=700)render();scene?.locate(e.longitude,e.latitude,1.3);});}
function sources(){modal(t('数据与来源','Data & sources'),`<p>${t('各指标按独立周期更新；新闻使用已发布采集快照，生态脉动为模拟。来源集中展示，保留统计期、样本范围与缺口。','Measures update independently. News uses published collection snapshots; the pulse is simulated. Centralized evidence retains each period, scope and gap.')}</p><div class="source-block"><h3>GOSD 2026 · ${t('地域观测','Regional observations')}</h3>${layers.filter(l=>isRegional(l.id)).map(l=>`<p><b>${tr(l.name)}</b> · ${tr(l.scope)}<br>${esc(sourceText(l.id,state.lang,data))} <a href="${esc(l.id==='developers'?data.activeDevelopers.source.url:data.report.areas[l.id].sourceUrl)}" target="_blank" rel="noopener">${t('图件','Figure')} ↗</a></p>`).join('')}</div><div class="source-block"><h3>${t('代码资产 · 月度仓库榜','Code assets · monthly repository ranking')}</h3><p>${esc(tr(data.repoRanking.note))}</p><a href="${esc(data.repoRanking.sourceUrl)}" target="_blank" rel="noopener">2026.09 · OpenShare ↗</a> · <a href="${esc(data.repoRanking.dataUrl)}" target="_blank" rel="noopener">${t('公开数据快照','Public snapshot')} ↗</a></div><div class="source-block"><h3>${t('组织、项目与位置','Organizations, projects & locations')}</h3><p>${t('企业、基金会、标杆项目、新势力项目、大模型项目采用报告第三章原表，排除模拟补位。当前已核验位置只是原表子集。高校与科研采用官方联系页样本；项目关联至组织总部，模型关联至发布方总部，均不表示历史发起地、训练或部署地点。','Chapter 3 original tables supply companies, foundations, benchmark projects, emerging projects and model versions; simulated extensions are excluded. Located entries are a subset. Universities use official contact pages. Project and model points refer to associated organizations, not historical origin, training or deployment.')}</p><a href="https://www.x-lab.info/2026-Global-Open-Source-Development-Report/2026/zh/chapters/03/" target="_blank" rel="noopener">${t('报告第三章','Report chapter 3')} ↗</a></div><div class="source-block"><h3>${t('基础设施与动态','Infrastructure & events')}</h3><p>${t('能源：WRI Global Power Plant Database 仓库快照的 12 座历史设施样本，各指定地域取原表最大容量记录。数据已停止维护，不表示当前在运状态或对 AI 设施的供电关系。原始经纬度、容量、源表与 SHA-256 保留。数据许可：CC BY 4.0。','Energy: 12 historical records from WRI Global Power Plant Database repository snapshot, selecting the highest-capacity record in each named region. The dataset is no longer maintained; records do not establish current operation or supply to AI facilities. Original coordinates, capacity, source records and SHA-256 are retained. Data license: CC BY 4.0.')}</p><a href="https://github.com/wri/global-power-plant-database" target="_blank" rel="noopener">WRI ↗</a><p>${t('算力：LUMI、JUPITER 官方位置；活动：Linux Foundation 主办方日程。新闻保留原发布时间，有地点证据才入图。每条实体详情均可查阅证据链接、位置角色与坐标精度。','Compute: official LUMI and JUPITER locations. Conferences: Linux Foundation organizer schedules. News retains its original publication date and requires location evidence for mapping. Entity details expose evidence, location role and coordinate precision.')}</p></div><div class="source-block"><h3>${t('全球概览与数据更新','Global coverage & update dates')}</h3><p>${t('前四项来自 OpenShare GOSD 同源元数据：地域覆盖、开发者、仓库、日志。246 是上游覆盖值，和地图已收录的 239 条地域观测不是同一口径。资讯总量 12,840 为模拟规模，当前实际采集快照为','The first four totals use OpenShare GOSD metadata: regions, developers, repositories and logs. Upstream coverage of 246 is distinct from the map’s 239 regional records. Intelligence inventory 12,840 is simulated; the collected snapshot contains')} ${actualEvents().length} ${t('条。','records.')}</p><p>${t('顶部“数据更新”表示本页核对与整理日期','The top “Updated” date is this page’s verification date')}: ${dashboard.checkedAt}。${t('上游原始快照更新','Original source snapshot')}: ${dashboard.upstream.summary.updatedAt.slice(0,10)}。${t('统计期','Period')}: 2025.07—2026.06。</p><a href="${dashboard.upstream.pageUrl}" target="_blank" rel="noopener">OpenShare GOSD ↗</a> · <a href="${dashboard.upstream.url}" target="_blank" rel="noopener">${t('原始元数据','Source metadata')} ↗</a><p>${t('生态脉动以报告基数、年度预测及模拟增量展示，未接入实时采集；点击动态指标或 ⓘ 查看完整口径。台湾是中国的一部分；中国实体筛选包含中国台湾，原始统计不自动相加。','The pulse combines report baselines, an annual forecast and simulated increments without live ingestion; its metric buttons and ⓘ explain all scopes. Taiwan is part of China; China entity filters include Taiwan without automatically summing source statistics.')}</p></div><p class="dialog-note">${t('沿用 OpenDipper 与 X-lab 品牌资产、Natural Earth 地理底图。保留应用、品牌与来源数据各自的许可边界。','Uses OpenDipper / X-lab brand assets and Natural Earth geography, retaining separate application, brand and data licenses.')}</p>`);}

async function start(){try{const names=['evidence.json','observation.json','events.json','countries.geojson','anchors.json','active-developers.json','snapshot.json','intelligence-demo.json','report-layers.json','located-entities.json','repo-ranking.json','dashboard-overview.json'];const raw=await Promise.all(names.map(async f=>{const r=await fetch(`${import.meta.env.BASE_URL}data/${f}`);if(!r.ok)throw Error(f);return r.json();}));dashboard=raw[11];data={evidence:raw[0],observation:raw[1],feed:raw[2],features:raw[3].features,anchors:raw[4].rows,activeDevelopers:raw[5],snapshot:raw[6],intelligence:raw[7],report:raw[8],located:raw[9],repoRanking:raw[10]};data.snapshot.repositories.forEach((r:any)=>r.key??=`${r.platform}:${r.path}`);regions=regionsFor(data);pointIndex=Object.fromEntries(layers.map(l=>[l.id,pointsFor(l.id,data)])) as Record<LayerId,Point[]>;const hash=location.hash.slice(1).split('?')[0];if(Object.hasOwn(pages,hash))state.page=hash as Page;render();void loadCatalog(import.meta.env.BASE_URL).then(()=>{if(state.page==='briefing')render();});await loadRadar(import.meta.env.BASE_URL);if(state.page==='radar'||state.page==='following')render();}catch(e){console.error(e);app.innerHTML='<div class="load-error"><h1>OpenDipper</h1><p>观测快照暂不可用 / Observation snapshot unavailable</p><button onclick="location.reload()">重试 / Retry</button></div>';}}
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&tour.active&&!document.querySelector('.modal')){e.preventDefault();exitTour();return;}if(e.key==='Escape'&&state.focus&&!document.querySelector('.modal')){e.preventDefault();void exitMapFullscreen();return;}if(state.page==='overview'&&(e.metaKey||e.ctrlKey)&&e.key==='k'){e.preventDefault();regionPicker();}if(e.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes((e.target as HTMLElement)?.tagName)){e.preventDefault();document.querySelector<HTMLInputElement>('#layer-search')?.focus();}});window.addEventListener('pagehide',()=>{tour.stop();disposePulse?.();disposeRadar?.();disposeGalaxy?.();scene?.destroy();});void start();

// Recheck published news snapshots; failures retain the last valid feed and never advance source dates.
const eventRefresh=window.setInterval(async()=>{if(document.hidden||!data)return;try{const response=await fetch(`${import.meta.env.BASE_URL}data/events.json`,{cache:'no-cache'});if(!response.ok)return;const next=await response.json();if(!Array.isArray(next.events)||JSON.stringify(next)===JSON.stringify(data.feed))return;data.feed=next;pointIndex.news=pointsFor('news',data);if(!document.querySelector('.modal'))render();}catch{}},300000);
window.addEventListener('pagehide',()=>clearInterval(eventRefresh));
